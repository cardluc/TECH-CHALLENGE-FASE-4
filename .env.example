# Copie este arquivo para .env e preencha a sua chave (o .env não vai para o GitHub)
OPENAI_API_KEY=

# Opcionais (valores padrão entre parênteses)
# OLIST_ORIGEM=C:\caminho\archive.zip   # .zip do Kaggle ou pasta com os CSVs (etapa bronze)
# LLM_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini               # modelo do LLM-as-a-judge na avaliação
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DEVICE=cpu                  # "cuda" se tiver GPU NVIDIA e torch com CUDA
# TOP_K=15                              # candidatos enviados ao juiz de relevância
# CANDIDATES=40                         # candidatos por buscador (denso e BM25) antes da fusão
# MIN_DENSE_SIM=0.35                    # similaridade mínima para considerar que há evidência
# MIN_EVIDENCE=3                        # nº mínimo de avaliações relevantes para responder
# CHROMA_DIR=C:\voc_rag\chroma          # pasta do índice vetorial (padrão: data/gold/chroma, ou
#                                       # C:\Users\<usuário>\.voc_rag\chroma se o caminho tiver acentos)
